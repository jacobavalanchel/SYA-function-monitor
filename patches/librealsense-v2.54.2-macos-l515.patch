+            darwin_device_capture(
+                std::shared_ptr<darwin_device_capture_registry> registry,
+                std::string key,
+                std::shared_ptr<darwin_device_capture_state> state);
+
+            std::shared_ptr<darwin_device_capture_registry> _registry;
+            std::string _key;
