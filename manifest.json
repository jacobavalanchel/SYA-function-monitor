{
  "id": "monitor",
  "version": "0.1.1",
  "runtime": "local-http",
  "entry": {
    "command": "bin/monitor-server",
    "args": []
  },
  "api": {
    "basePath": "/api/monitor",
    "health": {
      "method": "GET",
      "path": "/health"
    },
    "events": {
      "transport": "sse",
      "path": "/events"
    }
  },
  "permissions": ["screen", "camera", "storage"]
}
