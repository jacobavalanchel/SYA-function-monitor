{
  "id": "monitor",
  "version": "0.1.3",
  "runtime": "local-http",
  "entry": {
    "command": "bin/monitor-server",
    "args": []
  },
  "api": {
    "basePath": "/api/monitor",
    "health": {
      "method": "GET",
      "path": "/health"
    },
    "events": {
      "transport": "sse",
      "path": "/api/monitor/events"
    }
  },
  "capabilities": [
    "screen-monitoring",
    "camera-monitoring",
    "record-storage",
    "attention-config",
    "action-discovery",
    "generic-invoke"
  ],
  "events": ["screen.capture", "camera.frame", "screen.status", "camera.status"],
  "permissions": ["screen", "camera", "storage"]
}
