{
  "id": "monitor",
  "version": "0.1.3",
  "runtime": "local-http",
  "entry": {
    "command": "bin/monitor-server",
    "args": []
  },
  "api": {
    "basePath": "/api/monitor",
    "health": {
      "method": "GET",
      "path": "/health"
    },
    "events": {
      "transport": "sse",
      "path": "/api/monitor/events"
    }
  },
  "capabilities": [
    "screen-monitoring",
    "camera-monitoring",
    "record-storage",
    "attention-config",
    "action-discovery",
    "generic-invoke",
    "realsense-rgbd-source",
    "training-data-capture"
  ],
  "events": [
    "screen.capture",
    "camera.frame",
    "screen.status",
    "camera.status",
    "realsense.frame",
    "realsense.training.sample"
  ],
  "permissions": ["screen", "camera", "storage"]
}
