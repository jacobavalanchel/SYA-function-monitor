      "require": "./dist/renderer.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "require": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.10.1"
  }
}
