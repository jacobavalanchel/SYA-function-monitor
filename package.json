{
  "name": "@sya/function-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Private local monitoring function module for SYA.",
  "type": "commonjs",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "require": "./dist/main.js"
    },
    "./main": {
      "types": "./dist/main.d.ts",
      "require": "./dist/main.js"
    },
    "./renderer": {
