{
  "openapi": "3.1.0",
  "info": {
    "title": "SYA Monitor Function API",
    "version": "0.2.0",
    "description": "When FUNCTION_RUNTIME_TOKEN is configured at process startup, every declared operation (including SSE) requires Authorization: Bearer <token>. Missing, invalid or unsupported tokens receive 401 before dispatch. The empty security alternative applies only to standalone startup without a configured token; it is not an authentication bypass in token mode. The real runtime also enforces its loopback Host and standalone origin policy, returning 403 on rejection. Response bodies are unchanged between modes."
  },
  "security": [{ "RuntimeBearer": [] }, {}],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "401": { "$ref": "#/components/responses/RuntimeUnauthorized" },
          "403": { "$ref": "#/components/responses/RuntimeForbidden" },
          "200": {
            "description": "Monitor function health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            },
            "headers": {
              "X-SYA-Runtime-Proof": {
                "description": "Only emitted after Bearer authentication when FUNCTION_RUNTIME_PROOF_KEY is configured. Lowercase HMAC-SHA256 of sya-runtime-v1 under the independent per-spawn proof key. Standalone or keyless health omits the header.",
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      }
    },
