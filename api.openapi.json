    "/api/monitor/events": {
      "get": {
        "operationId": "events",
        "parameters": [
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "schema": { "type": "string" },
            "description": "Resume strictly after this retained attention observation or RealSense access event ID. The runtime retains the latest 2048 critical metadata events in one bounded in-memory buffer. Absent, unknown, or evicted IDs start live only; no full backfill is implied."
          }
        ],
        "responses": {
          "401": { "$ref": "#/components/responses/RuntimeUnauthorized" },
          "403": { "$ref": "#/components/responses/RuntimeForbidden" },
          "200": {
            "description": "Monitor server-sent events stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "description": "Authenticated SSE; attention.status and realsense.access carry stable record IDs as SSE IDs. realsense.access uses RealSenseAccessEvent and reports session-stop or asynchronous stream-error metadata, never images, serials, paths, exception text or raw-frame/preview counts. Retained critical events after Last-Event-ID preserve IDs, timestamps and sessions with delivery=replay. Images are not retained and cannot evict pending critical events without closing the stream for replay. Replay never establishes current freshness or triggers energy. The shared 2048-event buffer is lost on restart; consumers preserve disconnected gaps outside retention. The desktop host owns durable access auditing: before start/manual capture/training it must verify storage, record attempts and outcomes, and stop/verify inactive on audit failure or transport loss; if stop remains active it must terminate the runtime. Coverage is sessions and explicit manual captures, not SDK-internal raw reads or standalone non-desktop access. No per-frame ACK protocol is provided."
      }
    },
