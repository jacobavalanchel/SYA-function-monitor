{
  "openapi": "3.1.0",
  "info": {
    "title": "SYA Monitor Function API",
    "version": "0.2.0"
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Monitor function health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/manifest": {
      "get": {
        "operationId": "manifest",
        "responses": {
          "200": {
            "description": "Monitor function manifest",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/monitor/actions": {
      "get": {
        "operationId": "actions.list",
        "responses": {
          "200": {
            "description": "Callable monitor action list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/monitor/capabilities": {
      "get": {
        "operationId": "capabilities.list",
        "responses": {
          "200": {
            "description": "Monitor capabilities, events, permissions, and actions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/monitor/invoke": {
      "post": {
        "operationId": "invoke",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "type": "string"
                  },
                  "payload": {}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Invoked monitor action result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/monitor/screen/status": {
      "get": {
        "operationId": "screen.status",
        "responses": {
          "200": {
            "description": "Current screen monitor status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/monitor/screen/start": {
      "post": {
        "operationId": "screen.start",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "rateMs": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Started screen monitoring",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/monitor/screen/stop": {
      "post": {
        "operationId": "screen.stop",
        "responses": {
          "200": {
            "description": "Stopped screen monitoring",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/monitor/camera/status": {
      "get": {
        "operationId": "camera.status",
        "responses": {
          "200": {
            "description": "Current camera monitor status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/monitor/camera/start": {
      "post": {
        "operationId": "camera.start",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "enum": [
                      "builtin",
                      "realsense"
                    ]
                  },
                  "dataSource": {
                    "type": "string",
                    "enum": [
                      "builtin",
                      "realsense"
                    ]
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "fps": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "serial": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Started camera monitoring",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/monitor/camera/stop": {
      "post": {
        "operationId": "camera.stop",
        "responses": {
          "200": {
            "description": "Stopped camera monitoring",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/monitor/camera/show": {
      "post": {
        "operationId": "camera.show",
        "responses": {
          "200": {
            "description": "Showed the camera monitor window",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/monitor/camera/hide": {
      "post": {
        "operationId": "camera.hide",
        "responses": {
          "200": {
            "description": "Hid the camera monitor window",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/monitor/camera/sources": {
      "get": {
        "operationId": "camera.sources",
        "responses": {
          "200": {
            "description": "Available camera data sources",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/monitor/realsense/status": {
      "get": {
        "operationId": "realsense.status",
        "responses": {
          "200": {
            "description": "Intel RealSense adapter status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/monitor/realsense/devices": {
      "get": {
        "operationId": "realsense.devices",
        "responses": {
          "200": {
            "description": "Connected Intel RealSense devices",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/monitor/realsense/start": {
      "post": {
        "operationId": "realsense.start",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/RealSenseStartRequest"
                  }
                ],
                "required": [
                  "source"
                ],
                "properties": {
                  "source": {
                    "type": "string",
                    "const": "realsense"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Started Intel RealSense streaming",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/monitor/realsense/stop": {
      "post": {
        "operationId": "realsense.stop",
        "responses": {
          "200": {
            "description": "Stopped Intel RealSense streaming",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/monitor/realsense/capture": {
      "post": {
        "operationId": "realsense.capture",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/RealSenseCaptureRequest"
                  }
                ],
                "required": [
                  "purpose"
                ],
                "properties": {
                  "purpose": {
                    "type": "string",
                    "enum": [
                      "inference",
                      "training"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Captured a RealSense RGB/depth sample",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/monitor/realsense/frame/latest": {
      "get": {
        "operationId": "realsense.frame.latest",
        "summary": "Read the latest RealSense preview frame",
        "description": "Returns the latest bounded in-memory JPEG preview and focus result, or null before the first frame. No preview file is written to disk.",
        "responses": {
          "200": {
            "description": "Latest RealSense preview frame",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RealSenseFrameResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/monitor/realsense/training/start": {
      "post": {
        "operationId": "realsense.training.start",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/RealSenseTrainingStartRequest"
                  }
                ],
                "required": [
                  "label"
                ],
                "properties": {
                  "label": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Started a RealSense training data capture session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/monitor/realsense/training/stop": {
      "post": {
        "operationId": "realsense.training.stop",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "stopCamera": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stopped the active RealSense training data capture session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/monitor/storage/stats": {
      "get": {
        "operationId": "storage.stats",
        "responses": {
          "200": {
            "description": "Monitor storage statistics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/monitor/storage/screen-records": {
      "get": {
        "operationId": "storage.screenRecords",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stored screen records",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/monitor/storage/camera-records": {
      "get": {
        "operationId": "storage.cameraRecords",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stored camera records",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/monitor/attention/config/status": {
      "get": {
        "operationId": "attention.config.status",
        "responses": {
          "200": {
            "description": "Attention LLM configuration status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/monitor/events": {
      "get": {
        "operationId": "events",
        "responses": {
          "200": {
            "description": "Monitor server-sent events stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/monitor/settings/status": {
      "get": {
        "operationId": "settings.status",
        "summary": "Read monitor settings",
        "responses": {
          "200": {
            "description": "Persisted monitor settings status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/monitor/settings/save": {
      "post": {
        "operationId": "settings.save",
        "summary": "Persist monitor settings",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved monitor settings status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RealSenseStartRequest": {
        "type": "object",
        "properties": {
          "width": {
            "type": "integer",
            "minimum": 1,
            "default": 640
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "default": 480
          },
          "fps": {
            "type": "integer",
            "minimum": 1,
            "default": 30
          },
          "colorWidth": {
            "type": "integer",
            "minimum": 1,
            "default": 640,
            "description": "Requested color stream width. The runtime may choose the nearest supported profile."
          },
          "colorHeight": {
            "type": "integer",
            "minimum": 1,
            "default": 480,
            "description": "Requested color stream height. The runtime may choose the nearest supported profile."
          },
          "colorFps": {
            "type": "integer",
            "minimum": 1,
            "default": 30
          },
          "depthWidth": {
            "type": "integer",
            "minimum": 1,
            "default": 640,
            "description": "Requested depth stream width. The runtime may choose the nearest supported profile."
          },
          "depthHeight": {
            "type": "integer",
            "minimum": 1,
            "default": 480,
            "description": "Requested depth stream height. The runtime may choose the nearest supported profile."
          },
          "depthFps": {
            "type": "integer",
            "minimum": 1,
            "default": 30
          },
          "enableColor": {
            "type": "boolean",
            "default": true
          },
          "enableDepth": {
            "type": "boolean",
            "default": true
          },
          "previewEnabled": {
            "type": "boolean",
            "default": true,
            "description": "Emit a bounded in-memory JPEG preview without persisting every frame."
          },
          "previewFps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "default": 2
          },
          "jpegQuality": {
            "type": "integer",
            "minimum": 40,
            "maximum": 90,
            "default": 72
          },
          "focusEnabled": {
            "type": "boolean",
            "default": true,
            "description": "Run optional local MediaPipe face and iris direction inference."
          },
          "focusFps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "default": 2
          },
          "serial": {
            "type": "string",
            "description": "Optional RealSense serial number when multiple devices are connected."
          }
        }
      },
      "RealSenseCaptureRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/RealSenseStartRequest"
          },
          {
            "type": "object",
            "properties": {
              "startIfNeeded": {
                "type": "boolean",
                "default": true
              },
              "keepRunning": {
                "type": "boolean",
                "default": false
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 1,
                "default": 5000
              },
              "sessionId": {
                "type": "string"
              },
              "label": {
                "type": "string",
                "description": "Optional training or inference label attached to the captured sample."
              }
            }
          }
        ]
      },
      "RealSenseTrainingStartRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/RealSenseStartRequest"
          },
          {
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "taskId": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              },
              "autoStart": {
                "type": "boolean",
                "default": true
              }
            }
          }
        ]
      },
      "AttentionRecord": {
        "type": "object",
        "required": [
          "id",
          "timestamp",
          "state",
          "confidence",
          "source",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "timestamp": {
            "type": "integer",
            "description": "Unix epoch milliseconds."
          },
          "state": {
            "type": "string",
            "enum": [
              "focused",
              "distracted",
              "away",
              "unknown"
            ]
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1,
            "description": "Null when the heuristic does not expose calibrated probability."
          },
          "source": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "modelVersion": {
            "type": "string"
          },
          "directions": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "RealSenseFrame": {
        "type": "object",
        "required": [
          "source",
          "frameId",
          "timestamp",
          "capturedAt",
          "frameNumber",
          "width",
          "height",
          "mimeType",
          "jpegBase64",
          "depth",
          "attention"
        ],
        "properties": {
          "source": {
            "const": "realsense"
          },
          "frameId": {
            "type": "string"
          },
          "timestamp": {
            "type": "integer",
            "description": "Unix epoch milliseconds."
          },
          "capturedAt": {
            "type": "string",
            "format": "date-time"
          },
          "frameNumber": {
            "type": "integer"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "mimeType": {
            "const": "image/jpeg"
          },
          "jpegBase64": {
            "type": "string",
            "contentEncoding": "base64",
            "contentMediaType": "image/jpeg"
          },
          "deviceSerial": {
            "type": "string"
          },
          "depth": {
            "type": "object",
            "required": [
              "available",
              "width",
              "height",
              "format",
              "depthScaleMeters"
            ],
            "properties": {
              "available": {
                "type": "boolean"
              },
              "width": {
                "type": "integer",
                "minimum": 0
              },
              "height": {
                "type": "integer",
                "minimum": 0
              },
              "format": {
                "type": "string"
              },
              "depthScaleMeters": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          },
          "attention": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AttentionRecord"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "RealSenseFrameResponse": {
        "type": "object",
        "required": [
          "ok",
          "data"
        ],
        "properties": {
          "ok": {
            "const": true
          },
          "data": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/RealSenseFrame"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "FunctionResponse": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "ok",
              "data"
            ],
            "properties": {
              "ok": {
                "const": true
              },
              "data": {}
            }
          },
          {
            "type": "object",
            "required": [
              "ok",
              "error"
            ],
            "properties": {
              "ok": {
                "const": false
              },
              "error": {
                "type": "object",
                "required": [
                  "code",
                  "message"
                ],
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "details": {}
                }
              }
            }
          }
        ]
      }
    }
  }
}
