  "components": {
    "securitySchemes": {
      "RuntimeBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Required for every operation when FUNCTION_RUNTIME_TOKEN is non-empty at startup. Standalone mode without that token permits unauthenticated requests subject to runtime access policy. The token and the independent process proof key must never be returned or logged."
      }
    },
    "responses": {
      "RuntimeUnauthorized": {
        "description": "Token-authenticated mode: missing, invalid or unsupported Authorization header; no operation is dispatched and no process proof is emitted.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/FunctionResponse" },
            "example": { "ok": false, "error": { "code": "UNAUTHORIZED", "message": "Missing or invalid runtime token." } }
          }
        }
      },
      "RuntimeForbidden": {
        "description": "Request rejected by the real runtime loopback Host or standalone origin policy before dispatch; no process proof is emitted.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/FunctionResponse" },
            "example": { "ok": false, "error": { "code": "FORBIDDEN", "message": "Monitor runtime accepts loopback requests only." } }
          }
        }
      }
    },
    "schemas": {
      "RealSenseAccessEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "timestamp", "source", "sessionId", "operation", "outcome", "errorCode", "active", "coverage", "delivery"],
        "properties": {
          "id": {"type": "string", "pattern": "^realsense-access-[0-9a-f-]{36}$"},
          "timestamp": {"type": "integer", "minimum": 0},
          "source": {"const": "realsense"},
          "sessionId": {"type": "string", "format": "uuid"},
          "operation": {"enum": ["session-stop", "stream-error"]},
          "outcome": {"enum": ["success", "denied", "error"]},
          "errorCode": {"enum": ["REALSENSE_STOPPED", "REALSENSE_PERMISSION_DENIED", "REALSENSE_STREAM_FAILED", "REALSENSE_STOP_FAILED"]},
          "active": {"type": "boolean", "description": "True means shutdown was not confirmed; the host must retry or terminate the runtime, never report stopped."},
          "coverage": {"const": "session"},
          "delivery": {"enum": ["live", "replay"]}
        },
        "description": "Metadata-only lifecycle evidence. start/status return sessionId and accessCoverage=session-and-manual-capture. Start/capture permission failures use REALSENSE_PERMISSION_DENIED; other failures use REALSENSE_START_FAILED or REALSENSE_CAPTURE_FAILED; a sample discarded after stop uses REALSENSE_CANCELLED. Error messages are controlled, not raw SDK exceptions. Cached status/latest-frame reads create no access event."
      },
      "RealSenseStartRequest": {
        "type": "object",
        "properties": {
          "width": {
            "type": "integer",
            "minimum": 1,
            "default": 640
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "default": 480
          },
          "fps": {
            "type": "integer",
            "minimum": 1,
            "default": 30
          },
          "colorWidth": {
            "type": "integer",
            "minimum": 1,
            "default": 640,
            "description": "Requested color stream width. The runtime may choose the nearest supported profile."
          },
          "colorHeight": {
            "type": "integer",
            "minimum": 1,
            "default": 480,
            "description": "Requested color stream height. The runtime may choose the nearest supported profile."
          },
          "colorFps": {
            "type": "integer",
            "minimum": 1,
            "default": 30
          },
          "depthWidth": {
            "type": "integer",
            "minimum": 1,
            "default": 640,
            "description": "Requested depth stream width. The runtime may choose the nearest supported profile."
          },
          "depthHeight": {
            "type": "integer",
            "minimum": 1,
            "default": 480,
            "description": "Requested depth stream height. The runtime may choose the nearest supported profile."
          },
          "depthFps": {
            "type": "integer",
            "minimum": 1,
            "default": 30
          },
          "enableColor": {
            "type": "boolean",
            "default": true
          },
          "enableDepth": {
            "type": "boolean",
            "default": true
          },
          "previewEnabled": {
            "type": "boolean",
            "default": true,
            "description": "Emit a bounded in-memory JPEG preview without persisting every frame."
          },
          "previewFps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "default": 2
          },
          "jpegQuality": {
            "type": "integer",
            "minimum": 40,
            "maximum": 90,
            "default": 72
          },
          "focusEnabled": {
            "type": "boolean",
            "default": true,
            "description": "Run optional local MediaPipe face and iris direction inference."
          },
          "focusFps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "default": 2
          },
          "serial": {
            "type": "string",
            "description": "Optional RealSense serial number when multiple devices are connected."
          }
        }
      },
      "RealSenseCaptureRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/RealSenseStartRequest"
          },
          {
            "type": "object",
            "properties": {
              "startIfNeeded": {
                "type": "boolean",
                "default": true
              },
              "keepRunning": {
                "type": "boolean",
                "default": false
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 1,
                "default": 5000
              },
              "sessionId": {
                "type": "string"
              },
              "label": {
                "type": "string",
                "description": "Optional training or inference label attached to the captured sample."
              }
            }
          }
        ]
      },
      "RealSenseTrainingStartRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/RealSenseStartRequest"
          },
          {
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "taskId": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              },
              "autoStart": {
                "type": "boolean",
                "default": true
              }
            }
          }
        ]
      },
      "AttentionRecord": {
        "type": "object",
        "required": [
          "id",
          "timestamp",
          "state",
          "confidence",
          "source",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "timestamp": {
            "type": "integer",
            "description": "Unix epoch milliseconds."
          },
          "state": {
            "type": "string",
            "enum": [
              "focused",
              "distracted",
              "away",
              "unknown"
            ]
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1,
            "description": "Null when the heuristic does not expose calibrated probability."
          },
          "source": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "modelVersion": {
            "type": "string"
          },
          "directions": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "kind": {
            "type": "string",
            "enum": [
              "transition",
              "observation",
              "boundary"
            ]
          },
          "observedAt": {
            "type": "integer",
            "minimum": 0,
            "description": "Fresh frame sample epoch milliseconds; equals timestamp. Boundary uses boundary time."
          },
          "stateChangedAt": {
            "type": "integer",
            "minimum": 0,
            "description": "First observation in this session, or latest state/source change. Stable observations retain this value."
          },
          "expectedIntervalMs": {
            "type": "integer",
            "minimum": 1,
            "description": "Expected fresh inference cadence: ceil(1000 / min(focusFps, colorFps)); default 500 ms. Not a freshness guarantee."
          },
          "sessionId": {
            "type": "string",
            "format": "uuid",
            "description": "New UUID for every successful stream start; distinct from training session ID."
          },
          "delivery": {
            "type": "string",
            "enum": [
              "live",
              "replay"
            ]
          },
          "boundary": {
            "type": "string",
            "enum": [
              "stopped",
              "disconnected"
            ],
            "description": "Present only for kind=boundary, whose state is unknown."
          }
        },
        "description": "Legacy records may omit observation fields. The attention-observation-heartbeat capability emits every successful fresh inference, plus explicit stopped/disconnected boundaries; polling cached previews never creates observations. No energy inference is provided."
      },
      "RealSenseFrame": {
        "type": "object",
        "required": [
          "source",
          "frameId",
          "timestamp",
          "capturedAt",
          "frameNumber",
          "width",
          "height",
          "mimeType",
          "jpegBase64",
          "depth",
          "attention"
        ],
        "properties": {
          "source": {
            "const": "realsense"
          },
          "frameId": {
            "type": "string"
          },
          "timestamp": {
            "type": "integer",
            "description": "Unix epoch milliseconds."
          },
          "capturedAt": {
            "type": "string",
            "format": "date-time"
          },
          "frameNumber": {
            "type": "integer"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "mimeType": {
            "const": "image/jpeg"
          },
          "jpegBase64": {
            "type": "string",
            "contentEncoding": "base64",
            "contentMediaType": "image/jpeg"
          },
          "deviceSerial": {
            "type": "string"
          },
          "depth": {
            "type": "object",
            "required": [
              "available",
              "width",
              "height",
              "format",
              "depthScaleMeters"
            ],
            "properties": {
              "available": {
                "type": "boolean"
              },
              "width": {
                "type": "integer",
                "minimum": 0
              },
              "height": {
                "type": "integer",
                "minimum": 0
              },
              "format": {
                "type": "string"
              },
              "depthScaleMeters": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          },
          "attention": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AttentionRecord"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "RealSenseFrameResponse": {
        "type": "object",
        "required": [
          "ok",
          "data"
        ],
        "properties": {
          "ok": {
            "const": true
          },
          "data": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/RealSenseFrame"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "FunctionResponse": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "ok",
              "data"
            ],
            "properties": {
              "ok": {
                "const": true
              },
              "data": {}
            }
          },
          {
            "type": "object",
            "required": [
              "ok",
              "error"
            ],
            "properties": {
              "ok": {
                "const": false
              },
              "error": {
                "type": "object",
                "required": [
                  "code",
                  "message"
                ],
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "details": {}
                }
              }
            }
          }
        ]
      },
      "AttentionObservation": {
        "allOf": [
          {
            "$ref": "#/components/schemas/AttentionRecord"
          },
          {
            "type": "object",
            "required": [
              "kind",
              "observedAt",
              "stateChangedAt",
              "expectedIntervalMs",
              "sessionId",
              "delivery"
            ],
            "not": {
              "required": [
                "energy"
              ]
            },
            "if": {
              "properties": {
                "kind": {
                  "const": "boundary"
                }
              }
            },
            "then": {
              "required": [
                "boundary"
              ],
              "properties": {
                "state": {
                  "const": "unknown"
                }
              }
            },
            "else": {
              "not": {
                "required": [
                  "boundary"
                ]
              }
            }
          }
        ],
        "description": "Current provider attention.status payload. Legacy AttentionRecord remains accepted by consumers without assuming freshness."
      }
    }
  }
}
